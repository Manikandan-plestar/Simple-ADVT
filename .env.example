# ==========================================
# ADVT APP ROOT ENVIRONMENT TEMPLATE
# ==========================================
# Copy this file to backend/.env and populate with actual credentials.
PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=advt_app_user
DB_PASSWORD=your_db_password
DB_NAME=simple_advt

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL="ADVT App <your_email@gmail.com>"

JWT_SECRET=replace_with_a_secure_random_32_plus_char_secret_key
JWT_SECRET_PREVIOUS=

ALLOW_LEGACY_IDENTITY=true
ENFORCE_PROFILE_AUTH=false
ENABLE_TEST_OTP=false
TEST_OTP_ALLOWLIST=test1@gmail.com,test2@gmail.com
VERIFY_PLAY_PURCHASES=false
MIN_SUPPORTED_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
