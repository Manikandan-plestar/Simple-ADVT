# Security & JWT Tokens
JWT_SECRET=simple_advt_jwt_super_secret_key_2026_xyz
JWT_SECRET_PREVIOUS=

# Security Feature Flags (Safe Live Defaults)
ALLOW_LEGACY_IDENTITY=true
ENFORCE_PROFILE_AUTH=false
ENABLE_TEST_OTP=false
