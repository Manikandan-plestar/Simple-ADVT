# ==========================================
# ADVT APP SERVER ENVIRONMENT CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# MySQL Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=advt_app_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=simple_advt

# Nodemailer / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
FROM_EMAIL="ADVT App <your_email@gmail.com>"

# Security & JWT Tokens
# NOTE: Must be at least 32 characters in production
JWT_SECRET=replace_with_a_secure_random_32_plus_char_secret_key
JWT_SECRET_PREVIOUS=

# Feature Flags & Rollout Controls (Safe Defaults)
# ALLOW_LEGACY_IDENTITY: true = allows legacy x-user-id fallback with logging; false = requires JWT Bearer
ALLOW_LEGACY_IDENTITY=true

# ENFORCE_PROFILE_AUTH: false = allows unauthenticated profile read/update with logging; true = enforces JWT
ENFORCE_PROFILE_AUTH=false

# ENABLE_TEST_OTP: false in production; true allows test OTP for allowlisted accounts
ENABLE_TEST_OTP=false
TEST_OTP_ALLOWLIST=test1@gmail.com,test2@gmail.com

# Play Store / App Store Receipt Verification (Phase 3)
VERIFY_PLAY_PURCHASES=false
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# App Version Management
MIN_SUPPORTED_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0

# Rate Limiting & Expiry
OTP_EXPIRY_MINUTES=5
RATE_LIMIT_MAX_ATTEMPTS=3
RATE_LIMIT_WINDOW_MINUTES=10
